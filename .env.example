POSTGRES_DB=jobos
POSTGRES_USER=jobos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://jobos:change-me@db:5432/jobos
API_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
FRESHNESS_HOURS=48
HIGH_FIT_THRESHOLD=75

# Optional free search backend. Leave empty to use the no-key public providers.
# Configure the base URL of an instance you operate or are permitted to query.
SEARXNG_URL=
# Optional keyed backend; discovery works without it.
BRAVE_SEARCH_API_KEY=
# Optional Tavily search (results are cached; provider health is tracked). Free-first: leave empty.
TAVILY_API_KEY=
# The worker schedules bounded scans, exploration, frontier and reconciliation runs.
# Set to false to run only work you queue yourself (also editable in /discovery#settings).
DISCOVERY_SCHEDULER_ENABLED=true

# Phase 3: uploaded master resumes and generated tailored resumes are stored here (personal data,
# git-ignored). The API and worker must share this directory.
DATA_DIR=./data
# Optional AI rewording of resume bullets (openai or azure). Every rewrite is verified against your
# own facts and discarded if it adds anything unsupported. Leave empty for deterministic tailoring.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Required for azure (https://<resource>.openai.azure.com); optional for OpenAI-compatible APIs.
LLM_BASE_URL=
